# 이 파일을 복사해 .env.local 로 이름을 바꾸고 실제 값을 입력하세요.
# (.env.local 은 .gitignore 에 포함되어 GitHub 에 올라가지 않습니다)
#
# MongoDB Atlas → Database → Connect → Drivers 에서 연결 문자열을 복사하세요.
# <username>, <password> 를 실제 DB 사용자 정보로 바꾸고, 주소 끝의 / 뒤에 DB 이름(classmate)을 넣습니다.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/classmate?retryWrites=true&w=majority

# 비밀번호 찾기 메일을 보낼 Gmail 계정
#   GMAIL_APP_PASSWORD 는 Gmail 로그인 비밀번호가 아니라 Google 계정 → 보안 → 2단계 인증 → '앱 비밀번호'에서 만든 16자리입니다.
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=

# 학생용 계정: 나이스 교육정보 개방 포털(https://open.neis.go.kr) → 회원가입 → 인증키 신청에서 무료로 발급
#   없으면 학교 검색만 되고 학사일정·시간표는 불러올 수 없습니다.
NEIS_API_KEY=

# 푸시 알림용 VAPID 키 — `npx web-push generate-vapid-keys` 로 만든 값 (한 번 정하면 바꾸지 마세요)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 알림 발신자 연락처 (선택, 예: mailto:you@example.com)
VAPID_SUBJECT=

# Vercel Cron이 /api/cron/notify 를 호출할 때 쓰는 비밀값 (아무 긴 무작위 문자열)
CRON_SECRET=

# 검색 엔진 등록 (선택)
#   구글 서치 콘솔 → 'URL 접두어' → 'HTML 태그' 방식의 content="..." 값
GOOGLE_SITE_VERIFICATION=
#   네이버 서치어드바이저 → 'HTML 태그' 방식의 content="..." 값
NAVER_SITE_VERIFICATION=
#   사이트 주소 (도메인을 바꿨을 때만, 끝에 / 없이)
NEXT_PUBLIC_SITE_URL=https://classmate-explore.vercel.app
